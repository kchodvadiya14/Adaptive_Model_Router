# Application
APP_NAME=Adaptive Model Router
APP_ENV=development
DEBUG=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Router (Milestone 3+)
ROUTER_TYPE=rule_based
ROUTING_THRESHOLD=0.60
QUALITY_FLOOR=0.90
COST_PRIORITY=0.7
LATENCY_PRIORITY=0.3

# Fallback (Milestone 7)
FALLBACK_ENABLED=true
MAX_FALLBACK_ATTEMPTS=3
FALLBACK_ON_QUALITY_BELOW=0.85
FALLBACK_ESCALATION=tier_up

# Logging & Storage
STORE_PROMPTS=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/router.db
PROVIDER_TIMEOUT=60
USE_MOCK_PROVIDERS=false

# Evaluation
JUDGE_PROVIDER=mock
JUDGE_MODEL_ID=gpt-4o-mini
EVALUATE_ON_CHAT=true

# Optional: protect /v1/* OpenAI-compatible endpoints
ROUTER_API_KEY=

# LLM Provider API Keys (configure only what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Model Registry (override default model IDs per tier)
SMALL_MODEL_ID=
MEDIUM_MODEL_ID=
STRONG_MODEL_ID=
