APP_NAME=Adaptive Model Router
APP_ENV=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
STORE_PROMPTS=false
DATABASE_URL=sqlite:///./data/router.db

# Routing
ROUTER_TYPE=rule_based
QUALITY_FLOOR=0.80
COST_PRIORITY=0.7
LATENCY_PRIORITY=0.3

# Fallback & quality escalation
FALLBACK_ENABLED=true
MAX_FALLBACK_ATTEMPTS=3
FALLBACK_ON_QUALITY_BELOW=0.75
FALLBACK_ESCALATION=tier_up

# Quality judge: mock (offline heuristic), openai, or registry (any model in the registry)
JUDGE_PROVIDER=registry
JUDGE_MODEL_ID=openai/gpt-oss-120b
EVALUATE_ON_CHAT=true

# Provider keys (free tiers work)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bearer token required on /api/* and /v1/* when set. Set this for any non-local deployment.
ROUTER_API_KEY=
