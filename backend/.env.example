APP_NAME=Adaptive Model Router
APP_ENV=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
STORE_PROMPTS=false
DATABASE_URL=sqlite:///./data/router.db

# Routing: rule_based (static, works out of the box) or learned (predicts per-model quality from this
# deployment's own judged traffic; falls back to rule_based until LEARNED_MIN_SAMPLES outcomes exist)
ROUTER_TYPE=rule_based
QUALITY_FLOOR=0.80
COST_PRIORITY=0.7
LATENCY_PRIORITY=0.3

# Fallback & quality escalation
FALLBACK_ENABLED=true
MAX_FALLBACK_ATTEMPTS=3
FALLBACK_ON_QUALITY_BELOW=0.75
FALLBACK_ESCALATION=tier_up

# Quality judge: mock (offline heuristic), openai, or registry (any model in the registry)
JUDGE_PROVIDER=registry
JUDGE_MODEL_ID=openai/gpt-oss-120b
EVALUATE_ON_CHAT=true

# Provider keys (free tiers work)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bearer token required on /api/* and /v1/* when set. Set this for any non-local deployment.
ROUTER_API_KEY=

# Learned routing, calibration and shadow mode (all optional)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2   # 'hashing' = dependency-free, much cruder
COLLECT_EMBEDDINGS=false          # keep prompt embeddings (never text) with judged outcomes; always on for ROUTER_TYPE=learned
LEARNED_MIN_SAMPLES=50            # judged, embedded outcomes needed before leaving the static fallback
LEARNED_K=40
LEARNED_PRIOR_WEIGHT=3.0
LEARNED_MIN_SIMILARITY=0.5
EXPLORATION_BONUS=0.10
GUARD_WINDOW=50                   # quality guard: recent answers per task type
GUARD_MIN_SAMPLES=20
GUARD_TOLERANCE=0.05
SHADOW_ROUTER_ENABLED=false       # log what the learned router would choose, without acting on it
